{
  "expo": {
    "name": "amo_mobile_market",
    "slug": "amo_mobile_market",
    "scheme": "amo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ihyacinthe.amo_mobile_market",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "edgeToEdgeEnabled": true
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#e67e22"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "49b11845-df80-45c9-884b-44a4cbcd4258"
      }
    },
    "owner": "ihyacinthe",
    "plugins": [
      "expo-video",
      "expo-contacts"
    ]
  }
}
