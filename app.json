{
  "expo": {
    "name": "amo_mobile_market",
    "slug": "amo_mobile_market",
    "scheme": "amo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "native",
      "backgroundColor": "#030712"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ihyacinthe.amo_mobile_market",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#e67e22"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9cf51c39-18f5-4326-a7c1-a28002683822"
      }
    },
    "owner": "hyacintheee",
    "plugins": [
      "expo-video",
      "expo-contacts",
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ]
  }
}
